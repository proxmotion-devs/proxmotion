# What the production images are built from (docs/adr/0054): the panel and these files only,
# never an .env file, dependencies, built assets or local data.
**
!panel/
!deploy/docker/production/
panel/.env
panel/.env.*
!panel/.env.example
panel/.phpunit.cache/
panel/.phpunit.result.cache
panel/bootstrap/cache/*.php
panel/database/*.sqlite*
panel/node_modules/
panel/public/build/
panel/public/hot
panel/resources/js/actions/
panel/resources/js/routes/
panel/resources/js/wayfinder/
panel/storage/
panel/tests/
panel/vendor/
