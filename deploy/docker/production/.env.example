# Proxmotion with Docker Compose (docs/guides/docker-install.md): copy to .env next to compose.yml.
# Compose reads it for the services and for the values in compose.yml. Never commit it.

# The release to run (a tag of the images, without the "v").
PROXMOTION_VERSION=0.1.1
# PROXMOTION_REGISTRY=ghcr.io/proxmotion-devs
# Where nginx listens on this host: 80, or e.g. 127.0.0.1:8080 behind a TLS proxy on the same host.
PROXMOTION_HTTP_BIND=80

APP_NAME=Proxmotion
APP_ENV=production
# Generate one with: docker compose run --rm --no-deps migrate php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# The address administrators and the billing systems use, over HTTPS.
APP_URL=https://panel.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
# The containers share maintenance mode through Redis (docs/adr/0052 §5).
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

# The TLS proxy in front of nginx (docs/adr/0054): its addresses or CIDRs, comma-separated, whose
# X-Forwarded-* headers are believed. Leave empty when nothing is in front: trusting more lets
# clients choose the address that API token address limits and rate limits see.
TRUSTED_PROXIES=

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=proxmotion
DB_USERNAME=proxmotion
# Any long random string, e.g. from: openssl rand -hex 24
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

# Live server statistics (docs/adr/0036). ID, key and secret: random strings, e.g. from openssl rand -hex 16.
# Browsers reach Reverb through nginx at /app on the panel's address; REVERB_PUBLIC_* stay empty.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_PUBLIC_HOST=
REVERB_PUBLIC_PORT=
REVERB_PUBLIC_SCHEME=

# Browser console (docs/adr/0002): a random string the panel and the console proxy share, e.g. openssl rand -hex 32.
CONSOLE_PROXY_SECRET=

# Mail for password resets and notifications (docs/adr/0044).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Proxmotion

PROXMOTION_REQUIRE_ADMIN_2FA=true
# Further PROXMOTION_* defaults are listed in panel/.env.example; most are changed on Panel settings instead.
