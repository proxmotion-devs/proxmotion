{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://proxmotion.invalid/schemas/recipe.schema.json",
    "title": "Proxmotion app recipe (recipe.yaml)",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "slug",
        "name",
        "version",
        "category",
        "description",
        "os",
        "requirements",
        "network_models",
        "install_modes",
        "billing",
        "license",
        "timeout_minutes"
    ],
    "properties": {
        "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,48}[a-z0-9]$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "category": { "enum": ["vpn", "control-panel", "container", "web"] },
        "description": { "$ref": "#/$defs/text" },
        "os": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["family", "versions"],
                "properties": {
                    "family": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "versions": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "type": "string",
                            "pattern": "^[0-9][0-9.]*$"
                        }
                    }
                }
            }
        },
        "requirements": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min_memory_mib", "min_disk_mib", "min_cores"],
            "properties": {
                "min_memory_mib": { "type": "integer", "minimum": 128 },
                "min_disk_mib": { "type": "integer", "minimum": 1024 },
                "min_cores": { "type": "integer", "minimum": 1 }
            }
        },
        "network_models": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["bridged", "routed", "nat"] }
        },
        "install_modes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["order", "post"] }
        },
        "billing": { "enum": ["free", "paid"] },
        "license": { "enum": ["none", "external"] },
        "inputs": {
            "type": "array",
            "items": { "$ref": "#/$defs/input" }
        },
        "outputs": {
            "type": "array",
            "items": { "$ref": "#/$defs/output" }
        },
        "firewall": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["port", "proto"],
                "properties": {
                    "port": {
                        "type": ["integer", "string"],
                        "pattern": "^(\\{\\{ inputs\\.[a-z][a-z0-9_]* \\}\\}|[0-9]+)$",
                        "minimum": 1,
                        "maximum": 65535
                    },
                    "proto": {
                        "type": "string",
                        "pattern": "^(\\{\\{ inputs\\.[a-z][a-z0-9_]* \\}\\}|tcp|udp)$"
                    }
                }
            }
        },
        "actions": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "script"],
                "properties": {
                    "key": { "$ref": "#/$defs/key" },
                    "script": {
                        "type": "string",
                        "pattern": "^actions/[a-z0-9-]+\\.sh$"
                    },
                    "inputs": {
                        "type": "array",
                        "items": { "$ref": "#/$defs/input" }
                    }
                }
            }
        },
        "timeout_minutes": { "type": "integer", "minimum": 1, "maximum": 120 }
    },
    "$defs": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
        "text": {
            "type": "object",
            "additionalProperties": false,
            "required": ["en"],
            "properties": {
                "en": { "type": "string", "minLength": 1, "maxLength": 500 },
                "tr": { "type": "string", "minLength": 1, "maxLength": 500 }
            }
        },
        "input": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "type"],
            "properties": {
                "key": { "$ref": "#/$defs/key" },
                "type": {
                    "enum": [
                        "string",
                        "password",
                        "integer",
                        "port",
                        "boolean",
                        "enum",
                        "slug",
                        "email",
                        "domain"
                    ]
                },
                "label": { "$ref": "#/$defs/text" },
                "required": { "type": "boolean" },
                "default": { "type": ["string", "integer", "boolean"] },
                "options": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9._-]{1,40}$"
                    }
                },
                "min": { "type": "integer" },
                "max": { "type": "integer" },
                "max_length": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 255
                }
            },
            "allOf": [
                {
                    "if": { "properties": { "type": { "const": "enum" } } },
                    "then": { "required": ["options"] }
                }
            ]
        },
        "output": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "type"],
            "properties": {
                "key": { "$ref": "#/$defs/key" },
                "type": { "enum": ["text", "url", "file"] },
                "label": { "$ref": "#/$defs/text" },
                "filename": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                },
                "secret": { "type": "boolean" }
            },
            "allOf": [
                {
                    "if": { "properties": { "type": { "const": "file" } } },
                    "then": { "required": ["filename"] }
                }
            ]
        }
    }
}
