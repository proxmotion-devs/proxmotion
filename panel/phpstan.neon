includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 8

rules:
    # SQL text only from literals; values are bound (AGENTS.md §7).
    - Tests\PHPStan\LiteralSqlRule
