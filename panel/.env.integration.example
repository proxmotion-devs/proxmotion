# Copy to .env.integration (never committed) to run `composer test:integration`
# against a TEST Proxmox VE. See docs/guides/real-proxmox-verification.md.
# The tests create, change and delete VMs, but only in PROXMOX_TEST_POOL and
# only with VMIDs from PROXMOX_TEST_VMID_FROM up.

# One host, or several comma-separated hosts of the same cluster.
PROXMOX_TEST_HOST=pve-test.example.com
PROXMOX_TEST_PORT=8006
PROXMOX_TEST_TOKEN_ID=proxmotion@pve!panel
PROXMOX_TEST_TOKEN_SECRET=
# false for a self-signed test node
PROXMOX_TEST_VERIFY_TLS=true
PROXMOX_TEST_POOL=proxmotion-test

PROXMOX_TEST_NODE=pve1
PROXMOX_TEST_STORAGE=local-lvm
PROXMOX_TEST_BRIDGE=vmbr0
# A template with qemu-guest-agent, in the pool
PROXMOX_TEST_TEMPLATE_VMID=9000
# The tests only touch VMIDs from here up (at least 1000)
PROXMOX_TEST_VMID_FROM=990000
