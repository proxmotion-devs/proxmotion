APP_NAME=Proxmotion
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# SQLite only (config/database.php): lock wait in ms, journal, transaction mode.
# DB_BUSY_TIMEOUT=5000
# DB_JOURNAL_MODE=wal
# DB_TRANSACTION_MODE=IMMEDIATE
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Proxmotion
# Administrators must confirm TOTP 2FA before using the admin panel. Only disable for local development.
PROXMOTION_REQUIRE_ADMIN_2FA=true
# Link to the full guides (the docs/ folder) shown on the Help page; empty for none.
PROXMOTION_DOCS_URL=
# Lowest VMID for new servers (0: Proxmox's next free ID).
PROXMOTION_MIN_VMID=0
# Creating or reinstalling a server fails when it has not finished after this many minutes (docs/adr/0032).
PROXMOTION_PROVISIONING_DEADLINE_MINUTES=120
# A new or reinstalled server checks that this name resolves (empty: no DNS check; docs/adr/0032).
PROXMOTION_VERIFY_DNS_NAME=example.com
# Drift report: an active server's VM stopped for longer than this is reported (docs/adr/0005).
PROXMOTION_DRIFT_STOPPED_GRACE_MINUTES=60

# Browser console (docs/adr/0002). The console proxy (deploy/console-proxy) uses the same secret.
# Generate one with: php -r "echo bin2hex(random_bytes(32));"
CONSOLE_PROXY_SECRET=
# Public WebSocket URL of the console proxy; defaults to /console-ws on the panel host.
CONSOLE_WEBSOCKET_URL=
CONSOLE_MAX_MINUTES=60
CONSOLE_IDLE_MINUTES=15
