APP_NAME=Proxmotion
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# SQLite only (config/database.php): lock wait in ms, journal, transaction mode.
# DB_BUSY_TIMEOUT=5000
# DB_JOURNAL_MODE=wal
# DB_TRANSACTION_MODE=IMMEDIATE
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Live server statistics (docs/adr/0036): "reverb" with the REVERB_* settings below; "log" polls instead.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail transport (also used for email notifications, docs/adr/0044); stays in .env, never on Panel settings.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Proxmotion
# Administrators must confirm TOTP 2FA before using the admin panel. Only disable for local development.
PROXMOTION_REQUIRE_ADMIN_2FA=true
# The variables below up to PROXMOTION_NOTIFICATION_THROTTLE_MINUTES, and CONSOLE_MAX_MINUTES and
# CONSOLE_IDLE_MINUTES, are only defaults: once Admin > Panel settings is saved, its values are used (docs/adr/0038).
# Link to the full guides (the docs/ folder) shown on the Help page; empty for none.
PROXMOTION_DOCS_URL=
# Lowest VMID for new servers (0: Proxmox's next free ID).
PROXMOTION_MIN_VMID=0
# Creating or reinstalling a server fails when it has not finished after this many minutes (docs/adr/0032).
PROXMOTION_PROVISIONING_DEADLINE_MINUTES=120
# A new or reinstalled server checks that this name resolves (empty: no DNS check; docs/adr/0032).
PROXMOTION_VERIFY_DNS_NAME=example.com
# Moving servers to another cluster or location uses Proxmox's experimental remote migration: off unless true (docs/adr/0037).
PROXMOTION_CROSS_CLUSTER_MOVES=false
# A move fails when it has not finished after this many minutes; copying disks can take hours.
PROXMOTION_MOVE_DEADLINE_MINUTES=720
# Bandwidth limit of a move in KiB/s (empty: Proxmox's own limit).
PROXMOTION_MOVE_BWLIMIT_KIB=
# Servers may not open connections to these networks (comma-separated CIDRs, e.g. the panel's address; docs/adr/0034).
PROXMOTION_PROTECTED_NETWORKS=
# Drift report: an active server's VM stopped for longer than this is reported (docs/adr/0005).
PROXMOTION_DRIFT_STOPPED_GRACE_MINUTES=60
# Storage health (docs/adr/0047): storage space, thin pool metadata or disk wear used at or above these per cents.
PROXMOTION_STORAGE_WARNING_PERCENT=85
PROXMOTION_STORAGE_CRITICAL_PERCENT=95
# Traffic quotas (docs/adr/0039): a month starts on this day (1-28); counted traffic is both (in + out), out or in;
# a server over its quota is suspended with suspend (none: only recorded).
PROXMOTION_TRAFFIC_RESET_DAY=1
PROXMOTION_TRAFFIC_COUNTED=both
PROXMOTION_TRAFFIC_OVERRUN_ACTION=none
# Usage limits (docs/adr/0039): an average over the window at or above a limit is a violation (empty: off).
# CPU and memory in per cent of the server's own, disk read + write in MB/s, network in + out in Mbps.
PROXMOTION_USAGE_CPU_PERCENT=
PROXMOTION_USAGE_MEMORY_PERCENT=
PROXMOTION_USAGE_DISK_MB_S=
PROXMOTION_USAGE_NETWORK_MBPS=
PROXMOTION_USAGE_WINDOW_MINUTES=60
# What happens then: none (only recorded), stop (forced power-off) or suspend.
PROXMOTION_USAGE_ACTION=none
# Generated root passwords (new servers ordered without one, reinstalls, resets without a chosen password).
# The random part has PROXMOTION_PASSWORD_LENGTH characters (12-64) of lower (letters and digits), mixed or symbols.
# The format needs at least three kinds of characters (lowercase, uppercase, digits, symbols): Windows requires it.
PROXMOTION_PASSWORD_LENGTH=20
PROXMOTION_PASSWORD_CHARACTERS=mixed
PROXMOTION_PASSWORD_PREFIX=
PROXMOTION_PASSWORD_SUFFIX=
# Email notifications for administrators (docs/adr/0044), sent through the MAIL_* settings above.
# Extra recipients (comma-separated) get every event; repeated events are sent once per throttle window.
PROXMOTION_NOTIFICATIONS=false
PROXMOTION_NOTIFICATION_RECIPIENTS=
PROXMOTION_NOTIFICATION_THROTTLE_MINUTES=60

# Browser console (docs/adr/0002). The console proxy (deploy/console-proxy) uses the same secret.
# Generate one with: php -r "echo bin2hex(random_bytes(32));"
CONSOLE_PROXY_SECRET=
# Public WebSocket URL of the console proxy; defaults to /console-ws on the panel host.
CONSOLE_WEBSOCKET_URL=
CONSOLE_MAX_MINUTES=60
CONSOLE_IDLE_MINUTES=15

# Reverb, the WebSocket server of live server statistics (docs/adr/0036), used with BROADCAST_CONNECTION=reverb.
# ID, key and secret are any random strings; the panel signs channel access with the secret.
# REVERB_HOST/PORT/SCHEME: where the panel reaches Reverb; VITE_REVERB_*: where browsers do (behind nginx: /app on the panel host).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Without VITE_REVERB_APP_KEY the server page polls every 10 seconds instead.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
